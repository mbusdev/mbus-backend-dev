{
    "compilerOptions": {
        "module": "CommonJS",
        "target": "es2021",
        "moduleResolution": "Node",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "ignoreDeprecations": "6.0",
        "baseUrl": "./",
        "rootDir": "src",
        "outDir": "dist",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "src/legacy"
    ]
}