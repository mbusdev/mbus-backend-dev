MBUS_API_KEY=YOUR_API_KEY
RIDE_API_KEY=YOUR_API_KEY
GOOGLE_APPLICATION_CREDENTIALS=secrets/YOUR_KEY.json

# Auth (floor plans). Without JWT_SECRET and GOOGLE_CLIENT_IDS the /auth and /floorplans routes respond 503.
# JWT_SECRET: generate with `openssl rand -base64 48`
JWT_SECRET=
# Comma separated Google OAuth client IDs (iOS, Android, Web); any of them is accepted as the token audience
GOOGLE_CLIENT_IDS=
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=60
AUTH_DB_PATH=./data/auth.sqlite
# Folder with one floor plan JSON file per building (not in git)
FLOORPLANS_DIR=./data/floorplans
